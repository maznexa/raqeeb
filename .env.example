# --- Database ---
# App role (non-owner, subject to RLS) — used by api/worker for ALL tenant-scoped queries
DATABASE_URL=postgres://raqeeb_app:raqeeb_app@localhost:5432/raqeeb
# System role (BYPASSRLS) — cross-tenant identity/provisioning/billing operations ONLY
DATABASE_URL_SYSTEM=postgres://raqeeb_system:raqeeb_system@localhost:5432/raqeeb
# Owner role — used ONLY for migrations and seeding
DATABASE_URL_OWNER=postgres://raqeeb:raqeeb@localhost:5432/raqeeb

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=4000
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Mail (Mailpit in dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@raqeeb.local

# --- Billing (Stripe) ---
# Leave unset in dev/CI: the billing module runs its deterministic FakeStripeDriver.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO_MONTH=price_...
# STRIPE_PRICE_PRO_YEAR=price_...
# STRIPE_PRICE_BUSINESS_MONTH=price_...
# STRIPE_PRICE_BUSINESS_YEAR=price_...
